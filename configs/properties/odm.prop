# Display
persist.sys.miui_resolution=1200,2608,480

# Touchfeature
ro.vendor.touchfeature.type=247

# Fingerprint
persist.vendor.fingerprint.sensor_location=600|1956|120

# Sensor
persist.vendor.sensor.mischeck=true
ro.vendor.sensor.maxbrightness=6750
ro.vendor.proxcal.factor=2.84

# SKU
import /odm/etc/odm_${ro.boot.hwc}.prop
